# ==============================================
# تنظیمات محیطی اپلیکیشن «مسافر»
# نسخه فعلی کاملاً آفلاین است و به کلید API نیاز ندارد.
# در صورت افزودن قابلیت‌های آنلاین در آینده، مقادیر را اینجا قرار دهید
# و فایل را به .env تغییر نام دهید.
# ==============================================

# آدرس سرور (در صورت نیاز آینده)
API_BASE_URL=

# کلید API (در صورت نیاز آینده)
API_KEY=
